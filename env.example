# URL base da API monitorada
MONITOR_URL=http://127.0.0.1:8000

# Intervalo entre verificações (segundos)
CHECK_INTERVAL=5

# Timeout das requisições do monitor (segundos)
TIMEOUT=5

# Limite para classificar uma resposta como lenta (ms)
SLOW_THRESHOLD=1000

# Limite para alerta crítico de lentidão (ms)
ERROR_THRESHOLD=2000

# Arquivo de log
LOG_FILE=logs.txt
