# URL base da API monitorada (usada pelo monitor/cron)
MONITOR_URL=http://127.0.0.1:8000

# Intervalo entre verificações na execução contínua local (segundos)
CHECK_INTERVAL=30

# Timeout das requisições do monitor (segundos)
TIMEOUT=5

# Limite para classificar uma resposta como lenta (ms)
SLOW_THRESHOLD=1000

# Limite para marcar latência como crítica nos logs (ms)
ERROR_THRESHOLD=2000

# Arquivo de log da execução local
LOG_FILE=logs.txt

# Segredo usado para validar chamadas ao endpoint /api/cron/monitor.
# A Vercel envia automaticamente "Authorization: Bearer <CRON_SECRET>"
# quando essa variável está configurada no projeto.
CRON_SECRET=

# Persistência em produção (Upstash Redis REST — mesma base da Vercel KV).
# Se não configuradas, o sistema usa um arquivo JSON local (apenas dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
